<Window x:Class="PostaBridge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="980" Height="850" MinWidth="800" MinHeight="700" WindowStartupLocation="CenterScreen"
        Background="#F4F6FA" FontFamily="Segoe UI, Nirmala UI, Microsoft YaHei UI, Global User Interface" FontSize="14" Closing="Window_Closing" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
    <Border Background="White" BorderBrush="#E4E9F0" BorderThickness="0,0,0,1">
      <Grid Margin="32,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="40" Height="40" Background="#2366EB" CornerRadius="12" Margin="0,0,12,0">
            <Viewbox Margin="9"><Canvas Width="24" Height="24"><Path Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M2,5 L22,5 L22,19 L2,19 Z M2,5 L12,13 L22,5"/><Path Stroke="White" StrokeThickness="2" Data="M10,17 L16,17 M13,14 L16,17 L13,20"/></Canvas></Viewbox>
          </Border>
          <StackPanel VerticalAlignment="Center" MaxWidth="330"><TextBlock x:Name="ProductNameLabel" FlowDirection="LeftToRight" FontWeight="SemiBold" FontSize="21"/><TextBlock x:Name="TaglineLabel" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/></StackPanel>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
          <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Muted}"/>
          <ComboBox x:Name="LanguageBox" Width="170" Padding="8,6" FlowDirection="LeftToRight" DisplayMemberPath="NativeName" SelectedValuePath="Code" SelectionChanged="LanguageChanged">
            <ComboBox.ItemContainerStyle>
              <Style TargetType="ComboBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding NativeName}"/></Style>
            </ComboBox.ItemContainerStyle>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="36,22,36,20" MaxWidth="920">
        <TextBlock x:Name="HeadlineLabel" FontSize="29" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="DescriptionLabel" Foreground="{StaticResource Muted}" Margin="0,8,0,18" TextWrapping="Wrap"/>
        <Border Background="White" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="16" Padding="22">
          <StackPanel>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Background="#EEF4FF" CornerRadius="8" Width="26" Height="26" HorizontalAlignment="Left"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2366EB" FontWeight="SemiBold"/></Border>
              <TextBlock x:Name="SourceHeading" Grid.Column="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
            <Border x:Name="SourceCard" Background="#FAFBFD" BorderBrush="#DCE3EB" BorderThickness="1" CornerRadius="10" Padding="16">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock x:Name="SourceName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="SourceDetail" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:Name="SourceButton" Grid.Column="1" Click="ChooseSource" FlowDirection="LeftToRight"/>
              </Grid>
            </Border>
            <Grid Margin="0,24,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Background="#EEF4FF" CornerRadius="8" Width="26" Height="26" HorizontalAlignment="Left"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2366EB" FontWeight="SemiBold"/></Border>
              <TextBlock x:Name="DestinationHeading" Grid.Column="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="DestinationBox" Height="44" FlowDirection="LeftToRight" TextAlignment="Left" TextChanged="DestinationChanged" MinWidth="100"/>
              <Button x:Name="DestinationButton" Grid.Column="1" Margin="10,0,0,0" Click="ChooseDestination" FlowDirection="LeftToRight"/>
            </Grid>
            <TextBlock x:Name="DestinationNote" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"/>
            <Border Background="#F4F7FC" CornerRadius="9" Padding="13,11" Margin="0,20,0,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock x:Name="SplitLabel" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SplitNote" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,12,0" TextWrapping="Wrap"/></StackPanel>
                <ComboBox x:Name="SplitBox" Grid.Column="1" MinWidth="105" SelectedIndex="1" VerticalAlignment="Center" Padding="8,6" FlowDirection="LeftToRight">
                  <ComboBoxItem Tag="10240"/><ComboBoxItem Tag="20480"/><ComboBoxItem Tag="40960"/>
                </ComboBox>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
        <Border x:Name="ProgressCard" Background="White" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="16" Padding="24,20" Margin="0,16,0,0">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="StatusTitle" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
              <TextBlock x:Name="PercentLabel" Grid.Column="1" Text="—" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
            </Grid>
            <ProgressBar x:Name="JobBar" Height="7" Minimum="0" Maximum="100" Foreground="#2366EB" Background="#EAF0F8" BorderThickness="0" Margin="0,16,0,12"/>
            <TextBlock x:Name="StatusDetail" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatsLabel" Visibility="Collapsed" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="ErrorLabel" Visibility="Collapsed" Foreground="#AD313D" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <Grid Margin="0,19,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="OpenButton" HorizontalAlignment="Left" Visibility="Collapsed" Click="OpenOutput" FlowDirection="LeftToRight"/>
              <Button x:Name="ReportButton" Grid.Column="1" Visibility="Collapsed" Margin="0,0,10,0" Click="OpenReport" FlowDirection="LeftToRight"/>
              <Button x:Name="StartButton" Grid.Column="2" Background="#2366EB" Foreground="White" BorderBrush="#2366EB" IsEnabled="False" Click="StartConversion" Padding="22,12" FlowDirection="LeftToRight"/>
              <Button x:Name="CancelButton" Grid.Column="2" Visibility="Collapsed" Click="CancelConversion" FlowDirection="LeftToRight"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="#E4E9F0" BorderThickness="0,1,0,0" Background="#F4F6FA">
      <Grid Margin="32,0"><TextBlock x:Name="PrivacyLabel" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
        <Button x:Name="AboutButton" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" FontWeight="Normal" FontSize="11" Padding="5,4" MinHeight="24" Foreground="{StaticResource Muted}" Click="ShowAbout" FlowDirection="LeftToRight"/>
      </Grid>
    </Border>
  </Grid>
</Window>
