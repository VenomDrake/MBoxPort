<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>$(Product)</AssemblyName>
    <Description>Local MBOX to PST converter for Windows, without Outlook</Description>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PostaBridge.Engine/PostaBridge.Engine.csproj" />
    <Content Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../THIRD_PARTY.md" Link="THIRD_PARTY.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
